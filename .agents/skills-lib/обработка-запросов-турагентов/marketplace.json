{
  "name": "обработка-запросов-турагентов",
  "version": "2.0.0",
  "description": "Полное руководство по обработке запросов от турагентов и клиентов на туристические продукты в ОАЭ. Используй когда нужно подготовить карточку товара (тур, ресторан, билеты) для WhatsApp или Telegram, обработать запрос на расчёт стоимости, или ответить на вопросы о продуктах.",
  "author": "Tourism Content Team",
  "license": "MIT",
  "language": "ru",
  "keywords": [
    "туризм",
    "турагент",
    "ОАЭ",
    "Дубай",
    "WhatsApp",
    "Telegram",
    "форматирование",
    "карточки товаров",
    "туры",
    "экскурсии",
    "рестораны",
    "билеты",
    "аттракционы"
  ],
  "triggers": [
    "запрос турагента",
    "карточка товара",
    "тур в",
    "экскурсия в",
    "ресторан",
    "ужин с шоу",
    "dhow cruise",
    "сафари",
    "билеты в",
    "aquaventure",
    "img worlds",
    "dubai parks",
    "burj khalifa",
    "для whatsapp",
    "для telegram",
    "расчёт стоимости",
    "сколько стоит"
  ],
  "files": {
    "main": "SKILL.md",
    "templates": [
      "assets/templates/tour-whatsapp.txt",
      "assets/templates/tour-telegram.txt",
      "assets/templates/restaurant-whatsapp.txt",
